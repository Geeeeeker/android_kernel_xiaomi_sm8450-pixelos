# ====== 编译Image.gz-dtb，否者只生成arch/arm64/boot/Image ======
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_ARM64_APPENDED_DTB=y
# ====== 跳过错误 ======
CONFIG_WERROR=y
CONFIG_SECTION_MISMATCH_WARN_ONLY is not set
# ====== 开启模块支持 ======
MODULES=y
# ====== 编译辅助 ======
CONFIG_SECTION_MISMATCH_WARN_ONLY=y
# CONFIG_DEBUG_SECTION_MISMATCH is not set
# ====== 强制允许段不匹配（绕过某些编译错误） ======
CONFIG_SECTION_MISMATCH_WARN_ONLY=y
# CONFIG_DEBUG_SECTION_MISMATCH is not set

# ====== GCC编译相关项目 ======
# CONFIG_MODVERSIONS is not set
# CONFIG_CC_WERROR is not set
CONFIG_SECTION_MISMATCH_WARN_ONLY=y

# Frame-Warn (adjust value)
CONFIG_FRAME_WARN=4096

# ====== 开启杜比音效 ======
CONFIG_DOLBY_DS2=y
CONFIG_DOLBY_LICENSE=y
CONFIG_DTS_EAGLE=y
CONFIG_DTS_SRS_TM=y

# ====== 内核信息 ======
CONFIG_LOCALVERSION=" Geeeeeker-perf"
