# ====== KernelSU Manual Hook 模式（无 KPROBES） ======
# 核心依赖：禁用 KPROBES 系列，启用 Manual Hook
# CONFIG_KPROBES is not set
# CONFIG_KRETPROBES is not set
# CONFIG_KPROBE_EVENTS is not set
# CONFIG_HAVE_SYSCALL_TRACEPOINTS is not set

# 基础符号表支持（Manual 模式仍需要 kallsyms）
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_KERNEL=y

# ====== KernelSU 本体 ======
CONFIG_KSU=y
# CONFIG_KSU_KPROBES_HOOK is not set   # 禁用 kprobes 模式
CONFIG_KSU_MANUAL_HOOK=y               # 启用 manual hook
CONFIG_KPM=y                           # KernelSU 模块支持（可选）

# ====== SUSFS（Manual 模式适配） ======
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
# CONFIG_KSU_SUSFS_SUS_SU is not set   # 该项依赖 KPROBES，必须禁用
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_SUS_MAP=y

# 注意：如果 SUSFS 版本包含 CONFIG_KSU_SUSFS_SUS_OVERLAYFS，可保留，否则移除
